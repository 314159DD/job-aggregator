# Job Aggregator - Environment Configuration
# Copy this file to .env and fill in your values.

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === API Keys (Active Sources) ===
SERPAPI_KEY=
SERPER_API_KEY=            # used for Google dorking in discovery (credits may be exhausted)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# === API Keys (Phase 2 Sources) ===
FINDWORK_API_KEY=           # get from findwork.dev/developers (free)
REED_API_KEY=               # get from reed.co.uk/developers (free, 4000 calls/month)
ADZUNA_APP_ID=              # get from developer.adzuna.com (free, 250 calls/day)
ADZUNA_APP_KEY=             # paired with ADZUNA_APP_ID

# === API Keys (Disabled / Future) ===
INDEED_PUBLISHER_ID=        # Indeed Publisher program
OPENROUTER_API_KEY=         # for LLM-assisted classification (optional)

# === Observability ===
SENTRY_DSN=                 # Sentry error tracking DSN (leave blank to disable)
APP_ENV=production          # environment tag sent to Sentry (development|staging|production)

# === Circuit Breaker (production defaults shown) ===
CIRCUIT_BREAKER_THRESHOLD=3        # consecutive failures before opening circuit
CIRCUIT_BREAKER_COOLDOWN_HOURS=24  # hours before auto-reset after circuit open

# === ATS Drain Settings ===
ATS_REQUEST_DELAY=0.5       # seconds between ATS company requests
ATS_DEACTIVATE_AFTER_FAILURES=3  # DB-level deactivation threshold for ATS companies

# === Scheduler ===
CRON_INTERVAL_MINUTES=60
SCRAPER_INTERVAL_HOURS=6

# === Feature Flags ===
ENABLE_SCRAPERS=false
LOG_LEVEL=INFO
DRY_RUN=false

# === Docker / CRON mode ===
# AGGREGATOR_MODE=cron           # cron (default), once, discover, freshness, health, snapshot

# === Paths ===
LOG_FILE=/var/log/aggregator.log
LOCK_FILE=/tmp/aggregator.lock
